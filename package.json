{
  "name": "teleprompter-plus",
  "version": "0.11.6",
  "description": "Scroll notes as a teleprompter with mobile remote control, Stream Deck integration, countdown timer, and voice tracking.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/JuracyAmerico/obsidian-teleprompter-plus"
  },
  "homepage": "https://github.com/JuracyAmerico/obsidian-teleprompter-plus",
  "bugs": {
    "url": "https://github.com/JuracyAmerico/obsidian-teleprompter-plus/issues"
  },
  "license": "MIT",
  "author": "Americo",
  "keywords": [
    "obsidian",
    "teleprompter",
    "stream-deck",
    "presentation",
    "video",
    "recording",
    "scrolling",
    "tts",
    "text-to-speech"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package:plugin": "bun run build && bun scripts/package-plugin-runtime.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "icons:streamdeck": "bun scripts/generate-streamdeck-icons.ts && cd docs/icons/streamdeck && for f in *.svg; do rsvg-convert -w 288 -h 288 \"$f\" -o \"${f%.svg}.png\"; done",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@tsconfig/svelte": "^5.0.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.7.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.2",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "lucide-static": "^1.17.0",
    "obsidian": "^1.10.0",
    "postcss": "^8.5.6",
    "svelte": "^5.39.6",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^16.4.0",
    "obs-websocket-js": "^5.0.7",
    "vosk-browser": "^0.0.8",
    "ws": "^8.18.3"
  },
  "packageManager": "bun@1.3.14"
}
